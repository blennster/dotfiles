{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "mode": "primary",
      "temperature": 0.5,
    },
    "general": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    },
  },
  "mcp": {
    "serial": {
      "type": "local",
      "command": [
        "/Users/now/Private/serial-mcp/serial-mcp"
      ],
      "enabled": true
    },
    "nordic-mcp": {
      "enabled": true,
      "type": "remote",
      "url": "https://aidev.nordicsemi.com/mcp"
    }
  },
  "lsp": true,
  "provider": {
    "ollama": {
      "models": {
        "gemma4:26b-mlx": {
          "_launch": true,
          "name": "gemma4:26b-mlx"
        },
        "gemma4:e4b": {
          "_launch": true,
          "name": "gemma4:e4b"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
}
